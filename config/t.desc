# Shipped Leon descriptor for the shared cps engine.
#
# `lbt` searches `~/.config/leon`, `/etc/leon`, then the current directory for
# the first parseable `t.desc`, so this file is the developer/standalone
# default. To make the Leon boot-manager menu available system-wide, merge
# `[tui.leon]` into `~/.config/leon/t.desc` (or `/etc/leon/t.desc`).
#
# The path below is CWD-independent: `lbt tui` materializes the embedded
# `leon_menu.py` at `~/.config/leon/tuis/leon_menu.py` on first use.

[tui.leon]
name = "leon"
path = "~/.config/leon/tuis/leon_menu.py"
description = "shipped Leon boot-manager menu"
